{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/access.ts": {
      "includeFiles": "api/helpers/**"
    },
    "api/saliency.ts": {
      "maxDuration": 60,
      "includeFiles": "api/helpers/**"
    },
    "api/av-probe.ts": {
      "maxDuration": 60,
      "includeFiles": "api/helpers/**"
    },
    "api/av-download.ts": {
      "maxDuration": 60,
      "includeFiles": "api/helpers/**"
    },
    "api/av-fetch.ts": {
      "maxDuration": 60,
      "includeFiles": "api/helpers/**"
    },
    "api/av-transcribe.ts": {
      "maxDuration": 60,
      "includeFiles": "api/helpers/**",
      "memory": 1024
    },
    "api/brand-analyze.ts": {
      "maxDuration": 60,
      "includeFiles": "api/helpers/**"
    },
    "api/brand-edit.ts": {
      "maxDuration": 60,
      "includeFiles": "api/helpers/**",
      "memory": 1024
    }
  }
}
