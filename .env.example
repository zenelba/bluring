# Optional: Hugging Face token (helpful for rate limits / private Spaces)
# Copy to .env.local for local `vercel dev`, or set in Vercel dashboard for production.
HF_TOKEN=hf_YOUR_TOKEN_HERE

# MSI-Net Gradio Space used for Attention saliency inference
HF_SALIENCY_SPACE_URL=https://alexanderkroner-saliency.hf.space

# Secret used to sign access-session cookies (recommended in production)
ACCESS_SECRET=change-me-to-a-long-random-string

# Audio / Video mode — self-hosted Cobalt instance (required for YouTube/Facebook download)
# Public cobalt.tools is not for third-party apps; host your own: https://github.com/imputnet/cobalt
COBALT_API_URL=https://your-cobalt-instance.example
# Optional if your Cobalt instance requires Api-Key auth
COBALT_API_KEY=

# YouTube fallback when Cobalt tunnel is empty (live/HLS). Local / VPS only — not on Vercel serverless.
# Install: pip install yt-dlp  (or winget install yt-dlp). Auto-detects yt-dlp, py -m yt_dlp, python -m yt_dlp.
# YT_DLP_PATH=C:\path\to\yt-dlp.exe
# YT_DLP_PYTHON=py -m yt_dlp
# YT_DLP_DISABLED=1

# Audio / Video transcription (Soniox async STT)
SONIOX_API_KEY=
# Optional: defaults shown
# SONIOX_API_BASE_URL=https://api.soniox.com
# SONIOX_LANGUAGE=sl
# SONIOX_SPEAKER_DIARIZATION=true
# Poll timeout for long audio (ms). Default ~15 min local; on Vercel use SONIOX_MAX_WAIT_MS=(maxDuration-30)*1000
# SONIOX_MAX_WAIT_MS=770000
# Chunked Soniox jobs (needs ffmpeg/ffprobe): max ~270 min or ~280MB per chunk
# SONIOX_CHUNK_MAX_SEC=16200
# SONIOX_CHUNK_MAX_BYTES=293601280
# Local upload size limit for multipart transcribe (bytes). Vercel hosted apps may need a link instead.
# AV_MAX_CLIENT_UPLOAD_BYTES=536870912
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe

# OpenAI (Brand removal mode — not used for transcription)
OPENAI_API_KEY=sk-...
# Optional OpenAI-compatible base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# Brand removal mode (vision classify + gpt-image-1 edits)
OPENAI_BRAND_VISION_MODEL=gpt-4o-mini
OPENAI_BRAND_IMAGE_MODEL=gpt-image-1

# Text replace mode (OCR / layout detect). Falls back to OPENAI_BRAND_VISION_MODEL.
# OPENAI_TEXT_DETECT_MODEL=gpt-4o-mini
