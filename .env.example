# Optional: Hugging Face token (helpful for rate limits / private Spaces)
# Copy to .env.local for local `vercel dev`, or set in Vercel dashboard for production.
HF_TOKEN=hf_YOUR_TOKEN_HERE

# MSI-Net Gradio Space used for Attention saliency inference
HF_SALIENCY_SPACE_URL=https://alexanderkroner-saliency.hf.space

# Secret used to sign access-session cookies (recommended in production)
ACCESS_SECRET=change-me-to-a-long-random-string

# Audio / Video mode — self-hosted Cobalt instance (required for YouTube/Facebook download)
# Public cobalt.tools is not for third-party apps; host your own: https://github.com/imputnet/cobalt
COBALT_API_URL=https://your-cobalt-instance.example
# Optional if your Cobalt instance requires Api-Key auth
COBALT_API_KEY=

# Audio / Video transcription (Soniox async STT)
SONIOX_API_KEY=
# Optional: defaults shown
# SONIOX_API_BASE_URL=https://api.soniox.com
# SONIOX_LANGUAGE=sl
# SONIOX_SPEAKER_DIARIZATION=true

# OpenAI (Brand removal mode — not used for transcription)
OPENAI_API_KEY=sk-...
# Optional OpenAI-compatible base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# Brand removal mode (vision classify + gpt-image-1 edits)
OPENAI_BRAND_VISION_MODEL=gpt-4o-mini
OPENAI_BRAND_IMAGE_MODEL=gpt-image-1
