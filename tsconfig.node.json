{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowJs": true,
    "noEmit": true,
    "strict": true
  },
  "include": ["vite.config.ts", "api/**/*.ts", "api/**/*.js", "api/**/*.d.ts"]
}
